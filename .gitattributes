# 统一行尾：源码/文本使用 LF，二进制文件不做转换
* text=auto eol=lf

# 明确的文本类型
*.py    text eol=lf
*.pyi   text eol=lf
*.qss   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf

# Windows 批处理必须使用 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件：禁止行尾与差异转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.zip   binary
*.db    binary

# 语言与统计
*.py    linguist-language=Python
docs/images/* linguist-documentation

# 发布产物不参与语言统计
dist/*  linguist-vendored
